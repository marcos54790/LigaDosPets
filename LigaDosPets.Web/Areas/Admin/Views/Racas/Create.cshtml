@model LigaDosPets.Application.DTOs.Raca.CreateRacaDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nova Raça";
}

<div class="crud-page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="crud-back-btn">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="crud-page-title">Nova Raça</h4>
            <p class="crud-page-sub">Vincule a raça a uma espécie já cadastrada.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="crud-form-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <div class="crud-form-section" style="border:none; padding:0; margin:0;">
                    <div class="crud-form-section-title">Dados da raça</div>
                    <div class="mb-3">
                        <label class="crud-label">Nome da raça</label>
                        <input asp-for="Nome" class="form-control crud-input"
                               placeholder="Ex: Labrador, Shih Tzu, Siames..." autofocus />
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>
                    <div class="mb-3">
                        <label class="crud-label">Espécie</label>
                        <select asp-for="EspecieId" class="form-select crud-input"
                                asp-items="@(new SelectList(ViewBag.Especies, "Id", "Nome"))">
                            <option value="">Selecione uma espécie...</option>
                        </select>
                        <span asp-validation-for="EspecieId" class="field-error"></span>
                    </div>
                </div>

                <div class="crud-form-actions" style="border:none; padding-top:16px; margin-top:8px;">
                    <a asp-action="Index" class="text-muted text-decoration-none fw-500">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-custom btn-orange px-5 py-2">
                        <i class="bi bi-check-circle me-2"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}