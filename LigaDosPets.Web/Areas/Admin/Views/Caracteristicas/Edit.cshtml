@model LigaDosPets.Application.DTOs.Caracteristica.UpdateCaracteristicaDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Característica";
    var nomeAtual = ViewBag.Nome as string ?? "Característica";
}

<div class="crud-page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="crud-back-btn">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="crud-page-title">Editar: @nomeAtual</h4>
            <p class="crud-page-sub">Altere o nome da característica.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="crud-form-card">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <div class="crud-form-section" style="border:none; padding:0; margin:0;">
                    <div class="crud-form-section-title">Dados da característica</div>
                    <div class="mb-3">
                        <label class="crud-label">Nome</label>
                        <input asp-for="Nome" class="form-control crud-input" autofocus />
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>
                </div>

                <div class="crud-form-actions" style="border:none; padding-top:16px; margin-top:8px;">
                    <a asp-action="Index" class="text-muted text-decoration-none fw-500">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-custom btn-orange px-5 py-2">
                        <i class="bi bi-floppy me-2"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}