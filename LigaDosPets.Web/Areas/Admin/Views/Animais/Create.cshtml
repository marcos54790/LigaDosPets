@model LigaDosPets.Application.DTOs.Animal.CreateAnimalDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Novo Pet";
}

<div class="crud-page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="crud-back-btn">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="crud-page-title">Cadastrar Novo Pet</h4>
            <p class="crud-page-sub">O animal será publicado imediatamente no catálogo.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="crud-form-card">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="formCreateAnimal">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                @* Informações básicas *@
                <div class="crud-form-section">
                    <div class="crud-form-section-title">Informações básicas</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="crud-label">Nome do animal</label>
                            <input asp-for="Nome" class="form-control crud-input"
                                   placeholder="Ex: Lilica, Bob, Chico..." />
                            <span asp-validation-for="Nome" class="field-error"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="crud-label">Idade (anos)</label>
                            <input asp-for="Idade" type="number" min="0" max="100"
                                   class="form-control crud-input" placeholder="Ex: 3" />
                        </div>
                        <div class="col-md-3">
                            <label class="crud-label">Sexo</label>
                            <select asp-for="Sexo" class="form-select crud-input">
                                <option value="">Selecione...</option>
                                <option value="Macho">Macho</option>
                                <option value="Fêmea">Fêmea</option>
                            </select>
                        </div>
                    </div>
                </div>

                @* Categorização *@
                <div class="crud-form-section">
                    <div class="crud-form-section-title">Categorização</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="crud-label">Espécie</label>
                            <select asp-for="EspecieId" id="selectEspecie" class="form-select crud-input"
                                    asp-items="@(new SelectList(ViewBag.Especies, "Id", "Nome"))">
                                <option value="">Selecione...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="crud-label">Raça</label>
                            <select asp-for="RacaId" id="selectRaca" class="form-select crud-input" disabled>
                                <option value="">Aguardando espécie...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="crud-label">Porte</label>
                            <select asp-for="PorteId" class="form-select crud-input">
                                <option value="">Selecione...</option>
                                @foreach (var porte in (IEnumerable<dynamic>)ViewBag.Portes)
                                {
                                    <option value="@porte.Id">@porte.Nome</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                @* Características *@
                <div class="crud-form-section">
                    <div class="crud-form-section-title">Características</div>
                    <div class="crud-tags">
                        @foreach (var item in (IEnumerable<dynamic>)ViewBag.Caracteristicas)
                        {
                            <div>
                                <input type="checkbox" name="CaracteristicasIds"
                                       value="@item.Id" id="ctag_@item.Id" class="btn-check" />
                                <label class="crud-tag-label" for="ctag_@item.Id">
                                    <i class="bi bi-check2 me-1"></i>@item.Nome
                                </label>
                            </div>
                        }
                    </div>
                </div>

                @* Fotos *@
                <div class="crud-form-section">
                    <div class="crud-form-section-title">Fotos</div>
                    <div class="crud-upload-area" onclick="document.getElementById('inputFotos').click()">
                        <i class="bi bi-camera-fill crud-upload-icon"></i>
                        <p class="mb-1 fw-600">Clique para adicionar fotos</p>
                        <p class="text-muted small mb-0">JPG, PNG — máximo 5 fotos</p>
                        <input type="file" asp-for="Fotos" id="inputFotos"
                               multiple accept="image/*" class="d-none"
                               onchange="previewImages(this)" />
                    </div>
                    <div id="previewContainer" class="crud-preview-grid mt-3"></div>
                </div>

                @* Descrição — só um campo, sem "motivo de entrada" para admin *@
                <div class="crud-form-section">
                    <div class="crud-form-section-title">Sobre o animal</div>
                    <label class="crud-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control crud-input" rows="5"
                              placeholder="Personalidade, comportamento, preferências..."></textarea>
                    <span asp-validation-for="Descricao" class="field-error"></span>
                </div>

                @* Ações *@
                <div class="crud-form-actions">
                    <a asp-action="Index" class="text-muted text-decoration-none fw-500">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-custom btn-orange px-5 py-3">
                        <i class="bi bi-check-circle me-2"></i> Salvar e Publicar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/raca-dinamica.js" asp-append-version="true"></script>
    <script src="~/js/preview-foto.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
