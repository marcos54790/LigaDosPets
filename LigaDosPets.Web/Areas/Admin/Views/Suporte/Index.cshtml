@model IEnumerable<LigaDosPets.Application.DTOs.Conversa.ConversaResumoDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Central de Mensagens";
    var adminId = (int)ViewBag.AdminId;
}

<div class="crud-page-header">
    <div>
        <h4 class="crud-page-title">💬 Central de Mensagens</h4>
        <p class="crud-page-sub">Atenda os usuários que entraram em contato.</p>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="chat-lista-wrap">
        @foreach (var conversa in Model.OrderByDescending(c => c.UltimaMensagemEm))
        {
            <a asp-action="Atender" asp-route-id="@conversa.Id"
                   class="chat-lista-item @(conversa.NaoLidas > 0 ? "nao-lida" : "")">
                <div class="chat-lista-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="chat-lista-info">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="chat-lista-nome">@conversa.NomeOutroUsuario</span>
                        <span class="chat-lista-hora">
                            @(conversa.UltimaMensagemEm?.ToString("HH:mm") ?? "")
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(conversa.NomeAnimal))
                    {
                        <div class="chat-lista-animal">
                            <i class="bi bi-heart-fill me-1"></i>@conversa.NomeAnimal
                        </div>
                    }
                    <div class="d-flex align-items-center justify-content-between mt-1">
                        <span class="chat-lista-preview">
                            @(conversa.UltimaMensagem ?? "Sem mensagens ainda")
                        </span>
                        @if (conversa.NaoLidas > 0)
                        {
                            <span class="chat-badge-nao-lida">@conversa.NaoLidas</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="crud-empty">
        <div class="crud-empty-icon">💬</div>
        <h4>Nenhuma conversa ainda</h4>
        <p class="text-muted">As mensagens dos usuários aparecerão aqui.</p>
    </div>
}