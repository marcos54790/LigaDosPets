@model IEnumerable<LigaDosPets.Application.DTOs.Usuario.UsuarioListDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Usuários";
    var isAdmin = User.IsInRole("Administrador");
}

<div class="crud-page-header">
    <div>
        <h4 class="crud-page-title">👥 Usuários</h4>
        <p class="crud-page-sub">Gerencie os usuários cadastrados na plataforma.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn-custom btn-orange crud-add-btn">
            <i class="bi bi-plus-lg me-1"></i> Novo Usuário
        </a>
    }
</div>

@if (!isAdmin)
{
    <div class="alert alert-info rounded-3 d-flex align-items-center gap-2 mb-4"
         style="font-size:0.85rem;">
        <i class="bi bi-info-circle-fill fs-5"></i>
        <span>
            Como <strong>Gerente</strong>, você pode editar dados básicos e
            ativar/desativar <strong>usuários comuns</strong>.
            Promoção de roles e exclusão são restritas ao Administrador.
        </span>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="crud-table-wrap">
        <table class="crud-table">
            <thead>
                <tr>
                    <th style="width:50px">#</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    var roleClass = usuario.TipoUsuario switch
                    {
                        "Administrador" => "crud-badge-orange",
                        "Gerente" => "crud-badge-blue",
                        _ => "crud-badge-gray"
                    };
                    var roleIcon = usuario.TipoUsuario switch
                    {
                        "Administrador" => "bi-shield-fill",
                        "Gerente" => "bi-person-badge-fill",
                        _ => "bi-person-fill"
                    };
                    var podeEditar = isAdmin || usuario.TipoUsuario == "Usuário";

                    <tr>
                        <td class="text-muted small">@usuario.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="crud-simple-icon @(usuario.TipoUsuario == "Administrador" ? "orange" : usuario.TipoUsuario == "Gerente" ? "" : "purple")">
                                    <i class="bi @roleIcon"></i>
                                </div>
                                <span class="crud-animal-name">@usuario.Nome</span>
                            </div>
                        </td>
                        <td class="text-muted small">@usuario.Email</td>
                        <td>
                            <span class="crud-badge @roleClass">
                                <i class="bi @roleIcon me-1"></i>@usuario.TipoUsuario
                            </span>
                        </td>
                        <td>
                            @if (usuario.Ativo)
                            {
                                <span class="crud-badge crud-badge-green">
                                    <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Ativo
                                </span>
                            }
                            else
                            {
                                <span class="crud-badge crud-badge-gray">
                                    <i class="bi bi-circle me-1" style="font-size:0.5rem;"></i>Inativo
                                </span>
                            }
                        </td>
                        <td>
                            <div class="crud-actions">

                                @if (podeEditar)
                                {
                                    <a asp-action="Edit" asp-route-id="@usuario.Id"
                                       class="crud-action-btn edit" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                }

                                @* Promover role — só Admin, e não no próprio Admin *@
                                @if (isAdmin && usuario.TipoUsuario != "Administrador")
                                {
                                    <button type="button"
                                            class="crud-action-btn view"
                                            title="Alterar role"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalPromover"
                                            data-id="@usuario.Id"
                                            data-nome="@usuario.Nome"
                                            data-role="@usuario.TipoUsuario">
                                        <i class="bi bi-arrow-up-circle-fill"></i>
                                    </button>
                                }

                                @if (podeEditar)
                                {
                                    if (usuario.Ativo)
                                    {
                                        <form asp-action="Desativar" asp-route-id="@usuario.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="crud-action-btn reject" title="Desativar">
                                                <i class="bi bi-person-x-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Ativar" asp-route-id="@usuario.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="crud-action-btn approve" title="Ativar">
                                                <i class="bi bi-person-check-fill"></i>
                                            </button>
                                        </form>
                                    }
                                }

                                @if (isAdmin)
                                {
                                    <button type="button"
                                            class="crud-action-btn delete"
                                            title="Excluir permanentemente"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalExcluir"
                                            data-id="@usuario.Id"
                                            data-nome="@usuario.Nome">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="crud-empty">
        <div class="crud-empty-icon">👥</div>
        <h4>Nenhum usuário cadastrado</h4>
        <p class="text-muted">Os usuários aparecerão aqui conforme se registrarem.</p>
    </div>
}

@* ── Modal: Promover ──────────────────────────────────────── *@
@if (isAdmin)
{
    <div class="modal fade" id="modalPromover" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-0 pb-0"
                     style="background:linear-gradient(135deg,#eff6ff,#dbeafe);">
                    <div>
                        <h5 class="modal-title fw-bold text-primary mb-0">
                            <i class="bi bi-shield-fill-check me-2"></i>Alterar Role
                        </h5>
                        <p class="text-muted small mb-0" id="subtituloPromover"></p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formPromover" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body px-4 pt-4 pb-2">
                        <p class="text-muted small mb-3">
                            Role atual: <strong id="roleAtual"></strong>
                        </p>
                        <div class="d-flex flex-column gap-2">
                            <div>
                                <input type="radio" class="btn-check" name="novaRole" id="roleUsuario" value="Usuário" />
                                <label class="btn btn-outline-secondary w-100 text-start px-3 py-2 rounded-3 d-flex align-items-center gap-3" for="roleUsuario">
                                    <i class="bi bi-person-fill fs-5 text-secondary"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size:0.9rem;">Usuário</div>
                                        <div class="text-muted" style="font-size:0.75rem;">Acesso público — pode agendar visitas e adotar</div>
                                    </div>
                                </label>
                            </div>
                            <div>
                                <input type="radio" class="btn-check" name="novaRole" id="roleGerente" value="Gerente" />
                                <label class="btn btn-outline-primary w-100 text-start px-3 py-2 rounded-3 d-flex align-items-center gap-3" for="roleGerente">
                                    <i class="bi bi-person-badge-fill fs-5 text-primary"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size:0.9rem;">Gerente</div>
                                        <div class="text-muted" style="font-size:0.75rem;">Aprova animais, gerencia agendamentos e usuários comuns</div>
                                    </div>
                                </label>
                            </div>
                            <div>
                                <input type="radio" class="btn-check" name="novaRole" id="roleAdmin" value="Administrador" />
                                <label class="btn btn-outline-warning w-100 text-start px-3 py-2 rounded-3 d-flex align-items-center gap-3" for="roleAdmin">
                                    <i class="bi bi-shield-fill fs-5 text-warning"></i>
                                    <div>
                                        <div class="fw-bold" style="font-size:0.9rem;">Administrador</div>
                                        <div class="text-muted" style="font-size:0.75rem;">Acesso total — promove roles, exclui registros, exporta dados</div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4 pt-3 gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" id="btnConfirmarPromover" disabled>
                            <i class="bi bi-check-circle me-1"></i> Confirmar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalExcluir" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">Excluir usuário</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        Tem certeza que deseja excluir permanentemente
                        <strong id="nomeUsuarioExcluir"></strong>?
                        Esta ação não pode ser desfeita.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <form id="formExcluir" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i class="bi bi-trash3 me-1"></i> Excluir
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var modalPromover = document.getElementById('modalPromover');
        if (modalPromover) {
            modalPromover.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('subtituloPromover').textContent = btn.dataset.nome;
                document.getElementById('roleAtual').textContent = btn.dataset.role;
                document.getElementById('formPromover').action = '/Admin/Usuarios/Promover/' + btn.dataset.id;
                document.querySelectorAll('input[name="novaRole"]').forEach(r => {
                    r.checked = r.value === btn.dataset.role;
                });
                document.getElementById('btnConfirmarPromover').disabled = false;
            });
            document.querySelectorAll('input[name="novaRole"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    document.getElementById('btnConfirmarPromover').disabled = false;
                });
            });
        }

        var modalExcluir = document.getElementById('modalExcluir');
        if (modalExcluir) {
            modalExcluir.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('nomeUsuarioExcluir').textContent = btn.dataset.nome;
                document.getElementById('formExcluir').action = '/Admin/Usuarios/Delete/' + btn.dataset.id;
            });
        }
    </script>
}
