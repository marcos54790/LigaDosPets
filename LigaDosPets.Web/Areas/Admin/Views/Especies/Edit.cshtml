@model LigaDosPets.Application.DTOs.Especie.UpdateEspecieDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Editar Espécie";
    var especieId   = ViewBag.EspecieId as int? ?? 0;
    var especieNome = ViewBag.EspecieNome as string ?? "Espécie";
    var racas       = ViewBag.Racas as IEnumerable<LigaDosPets.Application.DTOs.Raca.RacaDto>
                      ?? Enumerable.Empty<LigaDosPets.Application.DTOs.Raca.RacaDto>();
}

<div class="crud-page-header">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="crud-back-btn">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="crud-page-title">Editar: @especieNome</h4>
            <p class="crud-page-sub">Altere o nome da espécie. As raças vinculadas são exibidas abaixo.</p>
        </div>
    </div>
</div>

<div class="row g-4 justify-content-center">

    @* Formulário de edição *@
    <div class="col-lg-5">
        <div class="crud-form-card">
            <form asp-action="Edit" asp-route-id="@especieId" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <div class="crud-form-section" style="border:none; padding:0; margin:0;">
                    <div class="crud-form-section-title">Dados da espécie</div>
                    <div class="mb-3">
                        <label class="crud-label">Nome da espécie</label>
                        <input asp-for="Nome" class="form-control crud-input" autofocus />
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>
                </div>

                <div class="crud-form-actions" style="border:none; padding-top:16px; margin-top:8px;">
                    <a asp-action="Index" class="text-muted text-decoration-none fw-500">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-custom btn-orange px-5 py-2">
                        <i class="bi bi-floppy me-2"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Raças vinculadas (somente leitura) *@
    <div class="col-lg-5">
        <div class="crud-form-card">
            <div class="crud-form-section-title mb-3">
                Raças vinculadas (@racas.Count())
            </div>
            @if (racas.Any())
            {
                <div class="especie-racas-list">
                    @foreach (var raca in racas)
                    {
                        <div class="especie-raca-item">
                            <i class="bi bi-tag-fill text-primary me-2" style="font-size:0.8rem;"></i>
                            <span>@raca.Nome</span>
                        </div>
                    }
                </div>
                <p class="text-muted small mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Para gerenciar raças, acesse o menu
                    <a asp-area="Admin" asp-controller="Racas" asp-action="Index">Raças</a>.
                </p>
            }
            else
            {
                <div class="crud-empty" style="padding:32px 16px;">
                    <div class="crud-empty-icon" style="font-size:2rem;">🏷️</div>
                    <p class="text-muted small mb-0">Nenhuma raça vinculada a esta espécie ainda.</p>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
