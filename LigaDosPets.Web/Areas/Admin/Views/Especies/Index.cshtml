@model IEnumerable<LigaDosPets.Application.DTOs.Especie.EspecieDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Espécies";
}

@* ── Cabeçalho ─────────────────────────────────────────────── *@
<div class="crud-page-header">
    <div>
        <h4 class="crud-page-title">🦎 Espécies</h4>
        <p class="crud-page-sub">Gerencie as espécies disponíveis para cadastro de animais.</p>
    </div>
    <a asp-action="Create" class="btn-custom btn-orange crud-add-btn">
        <i class="bi bi-plus-lg me-1"></i> Nova Espécie
    </a>
</div>

@* ── Tabela ────────────────────────────────────────────────── *@
@if (Model != null && Model.Any())
{
    <div class="crud-table-wrap">
        <table class="crud-table">
            <thead>
                <tr>
                    <th style="width:60px">#</th>
                    <th>Nome</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var especie in Model)
                {
                    <tr>
                        <td class="text-muted small">@especie.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="crud-simple-icon">
                                    <i class="bi bi-diagram-3-fill"></i>
                                </div>
                                <span class="crud-animal-name">@especie.Nome</span>
                            </div>
                        </td>
                        <td>
                            <div class="crud-actions">
                                <a asp-action="Edit" asp-route-id="@especie.Id"
                                   class="crud-action-btn edit" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button"
                                        class="crud-action-btn delete"
                                        title="Excluir"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalExcluir"
                                        data-id="@especie.Id"
                                        data-nome="@especie.Nome">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="crud-empty">
        <div class="crud-empty-icon">🦎</div>
        <h4>Nenhuma espécie cadastrada</h4>
        <p class="text-muted">Cadastre a primeira espécie pelo botão acima.</p>
    </div>
}

@* ── Modal: Excluir ────────────────────────────────────────── *@
<div class="modal fade" id="modalExcluir" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">Excluir espécie</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    Tem certeza que deseja excluir a espécie
                    <strong id="nomeEspecieExcluir"></strong>?
                    Todos os animais e raças vinculados podem ser afetados.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0 gap-2">
                <button type="button" class="btn btn-light rounded-pill px-4"
                        data-bs-dismiss="modal">Cancelar</button>
                <form id="formExcluir" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash3 me-1"></i> Excluir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var modalExcluir = document.getElementById('modalExcluir');
    if (modalExcluir) {
        modalExcluir.addEventListener('show.bs.modal', function (e) {
            var btn  = e.relatedTarget;
            document.getElementById('nomeEspecieExcluir').textContent = btn.dataset.nome;
            document.getElementById('formExcluir').action =
                '/Admin/Especies/Delete/' + btn.dataset.id;
        });
    }
</script>
}
