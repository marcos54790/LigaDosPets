@model List<LigaDosPets.Web.Models.AnimalModel>
@{
    ViewData["Title"] = "Catálogo de Animais";
}

@* ── Cabeçalho ─────────────────────────────────────────────── *@
<section class="catalog-hero">
    <div class="container text-center">
        <h1 class="catalog-hero-title">Nossos Heróis Esperando por Você</h1>
        <p class="catalog-hero-sub">Encontre seu novo melhor amigo entre os protetores da Liga.</p>
    </div>
</section>

<div class="container catalog-body">

    @* ── Filtros ──────────────────────────────────────────────── *@
    <div class="catalog-filters-bar">
        <div class="catalog-filters-scroll" id="filterBar">
            <button class="filter-pill active" data-filter="todos">Todos</button>
            <button class="filter-pill" data-filter="Cachorro">🐶 Cachorros</button>
            <button class="filter-pill" data-filter="Gato">🐱 Gatos</button>
            <button class="filter-pill" data-filter="Ave">🐦 Aves</button>
            <button class="filter-pill" data-filter="Peixe">🐟 Peixes</button>
            <button class="filter-pill" data-filter="Réptil">🦎 Répteis</button>
            <button class="filter-pill" data-filter="Roedor">🐹 Roedores</button>
            <div class="filter-divider"></div>
            <button class="filter-pill" data-sexo="Macho">♂ Machos</button>
            <button class="filter-pill" data-sexo="Fêmea">♀ Fêmeas</button>
        </div>
        <div class="catalog-count">
            <span id="countVisible">@Model?.Count</span> pet@(Model?.Count != 1 ? "s" : "") encontrado@(Model?.Count != 1 ? "s" : "")
        </div>
    </div>

    @* ── Grid de animais ──────────────────────────────────────── *@
    @if (Model != null && Model.Any())
    {
        <div class="row g-4" id="catalogGrid">
            @foreach (var animal in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3 catalog-item"
                     data-especie="@animal.EspecieNome"
                     data-sexo="@animal.Sexo">
                    <div class="pet-card border-0 shadow-sm h-100">
                        <a asp-controller="Details" asp-action="Details" asp-route-id="@animal.Id"
                           class="pet-card-link">
                            <div class="pet-card-img-wrapper">
                                <img src="@animal.FotoUrl"
                                     class="card-img-top"
                                     alt="@animal.Nome"
                                     loading="lazy"
                                     onerror="this.src='/images/pets/placeholder.jpg'">
                                <span class="badge-species">@animal.EspecieNome</span>
                                <div class="pet-card-overlay">
                                    <span class="pet-card-overlay-text">Ver História</span>
                                </div>
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column p-3">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <h5 class="card-title fw-bold mb-0">@animal.Nome</h5>
                                <span class="pet-sexo-icon @(animal.Sexo == "Macho" ? "male" : "female")">
                                    <i class="bi @(animal.Sexo == "Macho" ? "bi-gender-male" : "bi-gender-female")"></i>
                                </span>
                            </div>

                            <div class="pet-card-meta">
                                <span class="pet-meta-chip">@animal.RacaNome</span>
                                @if (animal.Idade.HasValue)
                                {
                                    <span class="pet-meta-chip">@animal.Idade ano@(animal.Idade > 1 ? "s" : "")</span>
                                }
                            </div>

                            <a asp-controller="Details" asp-action="Details" asp-route-id="@animal.Id"
                               class="btn-custom btn-blue-outline w-100 mt-auto py-2 text-center">
                                Conhecer História
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Estado vazio após filtro *@
        <div class="catalog-empty-filter text-center py-5" id="emptyFilter" style="display:none;">
            <div style="font-size:3rem;">🔍</div>
            <h4 class="mt-3">Nenhum pet encontrado</h4>
            <p class="text-muted">Tente outro filtro ou <button class="btn btn-link p-0" onclick="resetFiltros()">veja todos</button>.</p>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div style="font-size: 4rem;">🐾</div>
            <h3 class="mt-3">Nenhum herói disponível no momento</h3>
            <p class="text-muted">Tente voltar mais tarde ou entre em contato com o abrigo.</p>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/catalogo-filtros.js" asp-append-version="true"></script>
}
