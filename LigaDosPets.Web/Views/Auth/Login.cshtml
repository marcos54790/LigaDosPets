@model LigaDosPets.Web.Models.LoginModel
@{
    ViewData["Title"] = "Entrar";
    Layout = null; @* Layout próprio para não ter navbar/footer *@
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar — Liga dos Pets</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">

    <div class="auth-split">

        @* ── Painel visual (esquerda) ────────────────────────────── *@
        <aside class="auth-visual" style="background-image: url('/imagens/animais-login.jpg');">
            <div class="auth-visual-overlay">
                <a asp-controller="Home" asp-action="Index" class="auth-visual-logo">
                    🐾 Liga dos Pets
                </a>
                <div class="auth-visual-copy">
                    <h2>Cada login aproxima<br />um pet de um lar.</h2>
                    <p>Acesse sua conta para acompanhar adoções, agendamentos e muito mais.</p>
                </div>
                <div class="auth-visual-footer">
                    Ainda não tem conta?
                    <a asp-action="Register">Cadastre-se grátis →</a>
                </div>
            </div>
        </aside>

        @* ── Formulário (direita) ─────────────────────────────────── *@
        <main class="auth-form-wrap">
            <div class="auth-card">

                <a asp-controller="Home" asp-action="Index" class="auth-back">
                    <i class="bi bi-arrow-left me-1"></i> Voltar ao site
                </a>

                <div class="auth-header">
                    <h1 class="auth-title">Bem-vindo de volta 👋</h1>
                    <p class="auth-sub">Entre para continuar sua jornada</p>
                </div>

                @* Alerta de erro *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <form asp-action="Login" method="post" class="auth-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="auth-field">
                        <label asp-for="Email">E-mail</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-envelope auth-input-icon"></i>
                            <input asp-for="Email" type="email" class="form-control auth-input"
                                   placeholder="voce@email.com" autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <div class="auth-label-row">
                            <label asp-for="Senha">Senha</label>
                            <a href="#" class="link-muted">Esqueci minha senha</a>
                        </div>
                        <div class="auth-input-wrap">
                            <i class="bi bi-lock auth-input-icon"></i>
                            <input asp-for="Senha" type="password" class="form-control auth-input"
                                   placeholder="Sua senha" autocomplete="current-password" id="senhaInput" />
                            <button type="button" class="auth-eye-btn" onclick="togglePwd('senhaInput', this)"
                                    tabindex="-1" aria-label="Mostrar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Senha" class="field-error"></span>
                    </div>

                    <label class="auth-check-row">
                        <input asp-for="LembrarMe" type="checkbox" />
                        <span>Manter conectado</span>
                    </label>

                    <button type="submit" class="btn-custom btn-orange w-100 auth-submit" id="btnLogin">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Entrar
                    </button>
                </form>

                <p class="auth-switch">
                    Ainda não tem conta?
                    <a asp-action="Register">Cadastre-se grátis</a>
                </p>
            </div>
        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/auth-login.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
