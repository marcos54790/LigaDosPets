@model LigaDosPets.Web.Models.RegisterModel
@{
    ViewData["Title"] = "Cadastro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Criar Conta — Liga dos Pets</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">

    <div class="auth-split auth-split-reverse">

        @* ── Formulário (esquerda no cadastro) ───────────────────── *@
        <main class="auth-form-wrap">
            <div class="auth-card">

                <a asp-controller="Home" asp-action="Index" class="auth-back">
                    <i class="bi bi-arrow-left me-1"></i> Voltar ao site
                </a>

                <div class="auth-header">
                    <h1 class="auth-title">Crie sua conta 🐾</h1>
                    <p class="auth-sub">Junte-se à Liga e ajude a transformar vidas</p>
                </div>

                @* Alerta de erro *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <form asp-action="Register" method="post" class="auth-form" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="auth-field">
                        <label asp-for="Nome">Nome completo</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-person auth-input-icon"></i>
                            <input asp-for="Nome" type="text" class="form-control auth-input"
                                   placeholder="Seu nome completo" autocomplete="name" autofocus />
                        </div>
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Email">E-mail</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-envelope auth-input-icon"></i>
                            <input asp-for="Email" type="email" class="form-control auth-input"
                                   placeholder="voce@email.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Senha">Senha</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-lock auth-input-icon"></i>
                            <input asp-for="Senha" type="password" class="form-control auth-input"
                                   placeholder="Mínimo 6 caracteres" autocomplete="new-password"
                                   id="senhaInput" />
                            <button type="button" class="auth-eye-btn" onclick="togglePwd('senhaInput', this)"
                                    tabindex="-1" aria-label="Mostrar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Senha" class="field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmarSenha">Confirmar senha</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-lock-fill auth-input-icon"></i>
                            <input asp-for="ConfirmarSenha" type="password" class="form-control auth-input"
                                   placeholder="Repita a senha" autocomplete="new-password"
                                   id="confirmarSenhaInput" />
                            <button type="button" class="auth-eye-btn" onclick="togglePwd('confirmarSenhaInput', this)"
                                    tabindex="-1" aria-label="Mostrar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarSenha" class="field-error"></span>
                        <div id="senhaMismatch" class="field-error" style="display:none;">
                            As senhas não conferem.
                        </div>
                    </div>

                    @* Indicador de força da senha *@
                    <div class="senha-strength" id="strengthBar" style="display:none;">
                        <div class="strength-track">
                            <div class="strength-fill" id="strengthFill"></div>
                        </div>
                        <span class="strength-label" id="strengthLabel"></span>
                    </div>

                    <button type="submit" class="btn-custom btn-orange w-100 auth-submit" id="btnRegister">
                        <i class="bi bi-person-plus me-2"></i> Criar Conta
                    </button>

                    <p class="auth-terms">
                        Ao se cadastrar, você concorda com nossa
                        <a asp-controller="Home" asp-action="Privacy">política de privacidade</a>.
                    </p>
                </form>

                <p class="auth-switch">
                    Já tem conta?
                    <a asp-action="Login">Faça login</a>
                </p>
            </div>
        </main>

        @* ── Painel visual (direita no cadastro) ──────────────────── *@
        <aside class="auth-visual" style="background-image: url('/imagens/animais-login.jpg');">
            <div class="auth-visual-overlay">
                <a asp-controller="Home" asp-action="Index" class="auth-visual-logo">
                    🐾 Liga dos Pets
                </a>
                <div class="auth-visual-copy">
                    <h2>Juntos somos mais fortes por eles.</h2>
                    <p>Sua conta é o primeiro passo para transformar a vida de um animal.</p>
                    <div class="auth-visual-stats">
                        <div class="auth-stat">
                            <strong>18+</strong>
                            <span>Pets esperando</span>
                        </div>
                        <div class="auth-stat">
                            <strong>100%</strong>
                            <span>Gratuito</span>
                        </div>
                    </div>
                </div>
                <div class="auth-visual-footer">
                    Já tem conta?
                    <a asp-action="Login">Faça login →</a>
                </div>
            </div>
        </aside>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/auth-register.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
